# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
METADATA_BASEURL=http://localhost:3010

# Public (built into the browser bundle — not secret)
NEXT_PUBLIC_BACKEND_API_URL=https://your-backend.example.com/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_STRIPE_DONATE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_STRIPE_DONATE_RETURN_URL=http://localhost:3010/donate

# Pulse on its own subdomain (host only, no https://). Unset = Pulse stays at /pulse.
# Set this only for Production, or previews will redirect /pulse to the live subdomain.
NEXT_PUBLIC_PULSE_HOST=
# Share the login cookie across subdomains, e.g. .citizenmonitors.com
NEXT_PUBLIC_COOKIE_DOMAIN=

# Feature switches ("true" = on). Leave unset in production to keep them off.
NEXT_PUBLIC_FEATURE_COLLATION=

# Server only
STRIPE_DONATE_SECRET_KEY=sk_test_xxx

# Must match the backend's API access token. Added server-side by middleware.ts.
INHOUSE_API_ACCESS_TOKEN=
# Optional: backend URL used by the server proxy (defaults to NEXT_PUBLIC_BACKEND_API_URL)
BACKEND_API_URL=

# Newsletter (/newsletter): standalone newsletter + News & Insight publishing.
# Its own login, separate from backend admin accounts.
NEWSLETTER_USERNAME=
NEWSLETTER_PASSWORD=
# Long random string used to sign Newsletter page sessions (e.g. `openssl rand -base64 32`)
NEWSLETTER_SESSION_SECRET=
# Backend admin account the server uses for the Newsletter page (never shown to its users)
NEWSLETTER_BACKEND_EMAIL=
NEWSLETTER_BACKEND_PASSWORD=
